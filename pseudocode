🟩 Singleton Booking System
CLASS BookingSystemSingleton:
    STATIC _instance = None

    FUNCTION get_instance():
        IF _instance IS None:
            CREATE new instance
        RETURN _instance

    FUNCTION __init__():
        IF _instance EXISTS:
            RAISE error
        SET _instance TO self
        INITIALIZE users AS empty dictionary
        SET current_user TO None
        INITIALIZE services AS empty list





🟨 Payment Proxy
CLASS PaymentProxy:
    FUNCTION __init__(payment_service):
        SET self.payment_service TO payment_service

    FUNCTION pay(card_number=None, expiry=None, cvv=None):
        LOOP until success or cancel:
            PROMPT user for card details IF not provided
            VALIDATE card number, expiry date, and CVV
            TRY:
                CALL self.payment_service.process()
                BREAK
            EXCEPT PaymentFailedException:
                SHOW error
                ASK user to retry or cancel

CLASS RealPaymentService:
    FUNCTION process():
        PRINT "Payment processed successfully"






