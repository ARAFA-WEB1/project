🟧 Main Program
FUNCTION main():
    GET BookingSystem instance
    DISPLAY welcome message

    WHILE True:
        ASK user: Sign Up / Login / Exit
        IF Sign Up:
            ASK for username and password
            TRY to create User
            ADD to system.users
            SHOW success or error

        ELSE IF Login:
            ASK for credentials
            IF correct:
                SET system.current_user
                BREAK
            ELSE:
                SHOW invalid login

        ELSE IF Exit:
            RETURN

    INITIALIZE services as dictionary of BookingService instances

    WHILE True:
        DISPLAY service menu
        ASK user for choice
        IF choice valid:
            CALL service.book()
