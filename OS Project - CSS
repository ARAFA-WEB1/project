/* style.css — Premium Glassmorphism OS | Nova Terminal */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: radial-gradient(circle at 20% 30%, #0a0c12, #020308);
    min-height: 100vh;
    overflow-x: hidden;
    color: #eef2ff;
}

/* ========== HOME PAGE ========== */
.home-container {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 6rem;
    overflow: hidden;
    z-index: 2;
}

.bg-orb {
    position: absolute;
    width: 70vmax;
    height: 70vmax;
    background: radial-gradient(circle, rgba(110, 80, 255, 0.25), transparent 70%);
    border-radius: 50%;
    filter: blur(100px);
    top: -30%;
    left: -20%;
    animation: floatSlow 22s infinite alternate;
    pointer-events: none;
}

.bg-orb.second {
    background: radial-gradient(circle, rgba(255, 60, 172, 0.2), transparent);
    bottom: -20%;
    right: -15%;
    top: auto;
    left: auto;
    animation: floatSlow 28s infinite alternate-reverse;
}

.bg-orb.third {
    background: radial-gradient(circle, rgba(0, 200, 255, 0.15), transparent);
    width: 50vmax;
    height: 50vmax;
    top: 40%;
    left: 50%;
    transform: translate(-30%, -30%);
    animation: pulseGlow 12s infinite alternate;
}

@keyframes floatSlow {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(8%, 5%) scale(1.08); }
}

@keyframes pulseGlow {
    0% { opacity: 0.3; transform: translate(-30%, -30%) scale(0.9); }
    100% { opacity: 0.7; transform: translate(-30%, -30%) scale(1.1); }
}

#particleCanvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
}

.hero-content {
    position: relative;
    z-index: 10;
    max-width: 620px;
}

.glass-badge {
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: inline-block;
    padding: 0.5rem 1.2rem;
    border-radius: 100px;
    font-size: 0.75rem;
    letter-spacing: 2px;
    margin-bottom: 1.8rem;
    font-weight: 500;
    color: #b9c3e6;
}

h1 {
    font-size: 5.2rem;
    font-weight: 700;
    background: linear-gradient(135deg, #FFFFFF 0%, #b8a6ff 50%, #ff7bc7 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1.08;
    letter-spacing: -0.02em;
}

.subtitle {
    font-size: 1.2rem;
    color: #a8b3db;
    margin: 1.5rem 0 2rem;
    font-weight: 400;
    line-height: 1.5;
}

.hero-stats {
    display: flex;
    gap: 1rem;
    margin: 2rem 0 2.5rem;
}

.stat-card {
    background: rgba(20, 25, 45, 0.55);
    backdrop-filter: blur(12px);
    border-radius: 24px;
    padding: 0.75rem 1.3rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    transition: all 0.2s ease;
}

.stat-card i {
    color: #b77cff;
    font-size: 1rem;
}

.launch-btn {
    background: linear-gradient(95deg, #6b3aff, #cd3cff);
    border: none;
    padding: 1rem 2.2rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 50px;
    color: white;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    box-shadow: 0 12px 28px -8px rgba(100, 70, 255, 0.5);
    letter-spacing: 0.3px;
}

.launch-btn:hover {
    transform: scale(1.02);
    box-shadow: 0 22px 35px -12px rgba(100, 70, 255, 0.7);
    background: linear-gradient(95deg, #7b4bff, #dd4cff);
}

.floating-preview {
    position: relative;
    z-index: 10;
    width: 440px;
    animation: floatY 4s ease-in-out infinite alternate;
}

.preview-window {
    background: rgba(12, 15, 28, 0.7);
    backdrop-filter: blur(24px);
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    overflow: hidden;
    box-shadow: 0 25px 40px -15px rgba(0, 0, 0, 0.5);
}

.win-bar {
    padding: 14px 18px;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: #aaa;
}

.win-body {
    padding: 20px;
    font-family: 'Inter', monospace;
    font-size: 0.85rem;
}

.prompt {
    color: #c084fc;
    font-weight: 600;
}

.cmd {
    color: #aaf0ff;
}

.output-line {
    margin-top: 8px;
    color: #cbd5ff;
}

@keyframes floatY {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-18px); }
}

/* ========== LOADING OVERLAY ========== */
.loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(28px);
    z-index: 2000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: opacity 0.5s ease, visibility 0.5s;
    gap: 24px;
}

.loader-ring {
    width: 70px;
    height: 70px;
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-top: 2px solid #b77cff;
    border-right: 2px solid #ff7bc7;
    border-radius: 50%;
    animation: spin 0.9s infinite linear;
}

.loader-text {
    font-size: 0.8rem;
    letter-spacing: 3px;
    color: #b9c3e6;
}

.loader-progress {
    width: 200px;
    height: 2px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    overflow: hidden;
    position: relative;
}

.loader-progress::after {
    content: '';
    position: absolute;
    width: 40%;
    height: 100%;
    background: linear-gradient(90deg, #b77cff, #ff7bc7);
    animation: loadingProgress 1.2s infinite;
}

@keyframes loadingProgress {
    0% { left: -40%; width: 40%; }
    100% { left: 100%; width: 40%; }
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.hidden {
    display: none !important;
}

/* ========== TERMINAL OS MAIN ========== */
.terminal-os {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1000;
    background: radial-gradient(circle at 30% 20%, rgba(0, 0, 0, 0.88), #010101f2);
    backdrop-filter: blur(6px);
}

.os-backdrop {
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.3);
}

/* MODERN DOCK */
.modern-dock {
    position: fixed;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(16, 18, 32, 0.75);
    backdrop-filter: blur(28px);
    border-radius: 60px;
    padding: 10px 24px;
    display: flex;
    gap: 12px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    z-index: 1100;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5), 0 0 0 0.5px rgba(255, 255, 255, 0.05);
}

.dock-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    font-size: 0.7rem;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    padding: 8px 14px;
    border-radius: 40px;
    background: transparent;
    color: #b4c2f0;
}

.dock-icon i {
    font-size: 1.2rem;
    margin-bottom: 2px;
}

.dock-icon:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-5px);
    color: white;
}

.dock-icon.active {
    background: rgba(122, 74, 255, 0.25);
    border-bottom: 2px solid #c084fc;
    color: white;
}

/* FLOATING TERMINAL */
.floating-terminal {
    position: absolute;
    top: 8%;
    left: 8%;
    width: 84%;
    height: 76%;
    background: rgba(8, 10, 20, 0.7);
    backdrop-filter: blur(32px);
    border-radius: 36px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 30px 50px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 1050;
    transition: all 0.2s;
}

.terminal-header {
    padding: 1rem 1.5rem;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    justify-content: space-between;
    cursor: grab;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.3px;
}

.terminal-header:active {
    cursor: grabbing;
}

.terminal-title {
    color: #cdd6f4;
}

.window-controls i {
    margin-left: 14px;
    cursor: pointer;
    opacity: 0.7;
    transition: 0.2s;
}

.window-controls i:hover {
    opacity: 1;
    color: #ff7bc7;
}

.terminal-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.2rem;
    overflow-y: auto;
}

.output-area {
    flex: 1;
    overflow-y: auto;
    font-family: 'Inter', 'SF Mono', monospace;
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-right: 12px;
}

/* Custom scrollbar */
.output-area::-webkit-scrollbar {
    width: 5px;
}

.output-area::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
}

.output-area::-webkit-scrollbar-thumb {
    background: rgba(192, 132, 252, 0.5);
    border-radius: 10px;
}

.input-line {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 18px;
}

.input-prompt {
    color: #d9b4ff;
    font-weight: 600;
    font-size: 1rem;
}

#commandInput {
    background: rgba(25, 30, 50, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 40px;
    padding: 12px 20px;
    flex: 1;
    color: #f0f3ff;
    font-size: 0.9rem;
    outline: none;
    font-family: 'Inter', monospace;
    transition: all 0.2s;
}

#commandInput:focus {
    border-color: #c084fc;
    box-shadow: 0 0 12px rgba(192, 132, 252, 0.2);
    background: rgba(25, 30, 50, 0.8);
}

/* Glass Cards for Output */
.glass-card {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 20px;
    padding: 12px 18px;
    border-left: 3px solid #c084fc;
    transition: all 0.2s;
    animation: fadeSlide 0.25s ease-out;
}

@keyframes fadeSlide {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.cmd-highlight {
    background: rgba(192, 132, 252, 0.2);
    padding: 3px 10px;
    border-radius: 20px;
    font-weight: 500;
    font-family: monospace;
}

/* POPUP WIDGETS */
.glass-popup {
    position: fixed;
    top: 20%;
    left: 35%;
    width: 380px;
    background: rgba(12, 15, 28, 0.92);
    backdrop-filter: blur(36px);
    border-radius: 32px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    z-index: 1200;
    box-shadow: 0 25px 45px rgba(0, 0, 0, 0.6);
    animation: popupAppear 0.25s ease;
}

@keyframes popupAppear {
    from {
        opacity: 0;
        transform: scale(0.96) translateY(-10px);
    }
    to {
        opacity: 1;
        transform: scale(1) translateY(0);
    }
}

.popup-header {
    display: flex;
    justify-content: space-between;
    padding: 1rem 1.3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-weight: 600;
    font-size: 0.9rem;
}

.popup-header i {
    cursor: pointer;
    transition: 0.2s;
    opacity: 0.7;
}

.popup-header i:hover {
    opacity: 1;
    color: #ff7bc7;
}

.popup-content {
    padding: 1.2rem;
}

/* Calculator Grid */
.calc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    background: transparent;
}

.calc-grid button {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    padding: 14px;
    color: white;
    font-size: 1rem;
    cursor: pointer;
    transition: 0.15s;
}

.calc-grid button:hover {
    background: rgba(192, 132, 252, 0.3);
    transform: scale(0.98);
}

#calcDisplay {
    font-size: 2rem;
    text-align: right;
    padding: 0.5rem;
    margin-bottom: 1rem;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 20px;
    word-break: break-all;
}

#notesArea {
    width: 100%;
    height: 200px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 20px;
    color: white;
    padding: 14px;
    font-family: 'Inter', monospace;
    resize: vertical;
}

.music-player {
    text-align: center;
    padding: 2rem;
    font-size: 1.2rem;
}

.music-player i {
    font-size: 3rem;
    color: #c084fc;
    margin-bottom: 1rem;
    cursor: pointer;
}

.settings-option {
    margin-bottom: 1rem;
}

/* STATS WIDGET */
.stats-widget {
    position: fixed;
    top: 22px;
    right: 22px;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(16px);
    border-radius: 40px;
    padding: 8px 22px;
    display: flex;
    gap: 24px;
    font-size: 0.75rem;
    font-weight: 500;
    z-index: 1100;
    border: 1px solid rgba(255, 255, 255, 0.08);
    letter-spacing: 0.3px;
}

.stats-widget i {
    margin-right: 6px;
    color: #b77cff;
}

/* RESPONSIVE */
@media (max-width: 1000px) {
    .home-container {
        flex-direction: column;
        padding: 2rem;
        text-align: center;
        justify-content: center;
        gap: 3rem;
    }
    
    .floating-preview {
        width: 90%;
        max-width: 500px;
    }
    
    h1 {
        font-size: 3.5rem;
    }
    
    .hero-stats {
        justify-content: center;
    }
    
    .floating-terminal {
        width: 92%;
        left: 4%;
        height: 70%;
    }
    
    .modern-dock {
        gap: 6px;
        padding: 8px 16px;
    }
    
    .dock-icon span {
        display: none;
    }
    
    .dock-icon i {
        font-size: 1.2rem;
        margin: 0;
    }
    
    .glass-popup {
        width: 90%;
        left: 5%;
        top: 15%;
    }
    
    .stats-widget {
        top: 12px;
        right: 12px;
        padding: 5px 14px;
        gap: 12px;
        font-size: 0.65rem;
    }
}

@media (max-width: 600px) {
    h1 {
        font-size: 2.5rem;
    }
    
    .stat-card span {
        display: none;
    }
    
    .stat-card i {
        margin: 0;
    }
    
    .stat-card {
        padding: 0.6rem 1rem;
    }
}
