<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>NOVA | Terminal OS</title>
    <link rel="stylesheet" href="styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>

    <!-- HOME PAGE (LAUNCHER) -->
    <div id="homePage" class="home-container">
        <div class="bg-orb"></div>
        <div class="bg-orb second"></div>
        <div class="bg-orb third"></div>
        <canvas id="particleCanvas"></canvas>
        
        <div class="hero-content">
            <div class="glass-badge">✦ NOVA OS v1.0</div>
            <h1 class="glow-text">Terminal.<br>Redefined.</h1>
            <p class="subtitle">Cinematic intelligence meets minimalist power — a premium AI-driven workspace.</p>
            
            <div class="hero-stats">
                <div class="stat-card"><i class="fas fa-microchip"></i><span>M2 Neural Core</span></div>
                <div class="stat-card"><i class="fas fa-cloud-arrow-up"></i><span>Edge Sync</span></div>
                <div class="stat-card"><i class="fas fa-shield-alt"></i><span>Quantum Secure</span></div>
            </div>
            
            <button id="launchBtn" class="launch-btn">
                <span>Launch System</span> <i class="fas fa-arrow-right"></i>
            </button>
        </div>
        
        <div class="floating-preview">
            <div class="preview-window">
                <div class="win-bar"><span>terminal ~ zsh</span><div class="win-dots"></div></div>
                <div class="win-body">
                    <span class="prompt">➜</span> <span class="cmd">nova --status</span>
                    <div class="output-line">⚡ System ready • Neural interface online</div>
                </div>
            </div>
        </div>
    </div>

    <!-- LOADING OVERLAY (CINEMATIC TRANSITION) -->
    <div id="loadingOverlay" class="loading-overlay hidden">
        <div class="loader-ring"></div>
        <div class="loader-text">INITIALIZING KERNEL</div>
        <div class="loader-progress"></div>
    </div>

    <!-- TERMINAL OS MAIN INTERFACE -->
    <div id="terminalOS" class="terminal-os hidden">
        <div class="os-backdrop"></div>
        
        <!-- DOCK / TASKBAR -->
        <div class="modern-dock">
            <div class="dock-icon active" data-window="terminal"><i class="fas fa-terminal"></i><span>Console</span></div>
            <div class="dock-icon" data-window="explorer"><i class="fas fa-folder-open"></i><span>Files</span></div>
            <div class="dock-icon" data-window="calculator"><i class="fas fa-calculator"></i><span>Calc</span></div>
            <div class="dock-icon" data-window="notes"><i class="fas fa-pen-nib"></i><span>Notes</span></div>
            <div class="dock-icon" data-window="music"><i class="fas fa-headphones"></i><span>Wave</span></div>
            <div class="dock-icon" data-window="settings"><i class="fas fa-sliders-h"></i><span>Settings</span></div>
            <div class="dock-icon" id="exitToHome"><i class="fas fa-power-off"></i><span>Exit</span></div>
        </div>
        
        <!-- MAIN TERMINAL WINDOW (FLOATING GLASS) -->
        <div class="floating-terminal" id="mainTerminal">
            <div class="terminal-header" id="dragHandle">
                <div class="terminal-title">NOVA CONSOLE — interactive workspace</div>
                <div class="window-controls">
                    <i class="fas fa-window-minimize minimize-term"></i>
                    <i class="fas fa-times close-term" id="closeTermBtn"></i>
                </div>
            </div>
            <div class="terminal-body" id="terminalBody">
                <div class="output-area" id="outputArea">
                    <div class="welcome-message glass-card">
                        <i class="fas fa-rocket"></i> NOVA OS Terminal [v2.0.4]<br>
                        Type <span class="cmd-highlight">'help'</span> to explore AI commands. Premium workspace ready.
                    </div>
                </div>
                <div class="input-line">
                    <span class="input-prompt">❯❯</span>
                    <input type="text" id="commandInput" autofocus spellcheck="false" placeholder="enter command...">
                </div>
            </div>
        </div>
        
        <!-- POPUP WIDGETS (SYSTEM STATS / CALENDAR / NOTES etc) -->
        <div id="widgetExplorer" class="glass-popup hidden">
            <div class="popup-header"><span>File Explorer</span><i class="fas fa-times close-popup"></i></div>
            <div class="popup-content" id="explorerContent"></div>
        </div>
        <div id="widgetCalculator" class="glass-popup hidden">
            <div class="popup-header"><span>Neural Calc</span><i class="fas fa-times close-popup"></i></div>
            <div class="popup-content calc-grid" id="calcDisplay">0</div>
        </div>
        <div id="widgetNotes" class="glass-popup hidden">
            <div class="popup-header"><span>Nova Notes</span><i class="fas fa-times close-popup"></i></div>
            <textarea id="notesArea" placeholder="Write anything... sync with cloud..."></textarea>
        </div>
        <div id="widgetMusic" class="glass-popup hidden">
            <div class="popup-header"><span>Wave Player</span><i class="fas fa-times close-popup"></i></div>
            <div class="music-player"><i class="fas fa-play-circle"></i> Lofi Dreams — playing now</div>
        </div>
        <div id="widgetSettings" class="glass-popup hidden">
            <div class="popup-header"><span>Preferences</span><i class="fas fa-times close-popup"></i></div>
            <div class="settings-option"><label><input type="checkbox" id="themeToggle"> Dark Aurora (default)</label></div>
            <div class="settings-option"><label>Terminal Glow: <input type="range" min="0" max="100"></label></div>
        </div>
        
        <!-- LIVE STATS BAR -->
        <div class="stats-widget">
            <div><i class="fas fa-microchip"></i> <span id="cpuStat">CPU: 12%</span></div>
            <div><i class="fas fa-memory"></i> <span id="ramStat">RAM: 3.2GB</span></div>
            <div><i class="far fa-clock"></i> <span id="liveClock">--:--:--</span></div>
        </div>
    </div>
    
    <script src="script.js"></script>
</body>
</html>
